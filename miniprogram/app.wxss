@import "styles/tokens.wxss";
page { background: var(--bg-paper); color: var(--ink); font-size: 28rpx; }
.card { background: var(--card); border-radius: 24rpx; }
.btn { box-sizing: border-box; height: var(--btn-h); line-height: var(--btn-h); border-radius: var(--btn-radius);
  font-size: 26rpx; text-align: center; padding: 0 24rpx; }
.btn::after { border: none; }
.btn-primary { background: var(--ink); color: #fff; }
.btn-score { background: var(--accent-score); color: #fff; }
.btn-gray { background: #F3F4F6; color: #6B7280; }
.btn-outline-orange { background: #fff; color: #C2410C; border: 2rpx solid rgba(194,65,12,.35); }
.btn-cream { background: #FEF3C7; color: #92400E; }
.btn-muted { background: #F3F4F6; color: #6B7280; }
.input-base { width: 100%; height: 72rpx; line-height: 72rpx; padding: 0 24rpx; box-sizing: border-box;
  border: 2rpx solid rgba(80,60,30,.14); border-radius: 16rpx; background: var(--card); color: var(--ink); font-size: 26rpx; }
.w { width: 100%; }
/* 提交中：视觉置灰 + 不可点（配合各页 js 的 saving 防重标志） */
.is-submitting { opacity: .55; pointer-events: none; }
