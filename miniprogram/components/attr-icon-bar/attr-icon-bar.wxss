.bar { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20rpx 16rpx; }
.cell { display: flex; flex-direction: column; align-items: center; justify-content: center; border-radius: 20rpx; padding: 16rpx 8rpx; }
.ic { width: 60rpx; height: 60rpx; }
.sub { font-size: 16rpx; color: var(--ink-3); margin-top: 4rpx; }
.val { font-size: 20rpx; font-weight: 600; color: var(--ink); margin-top: 4rpx; }
.lbl { font-size: 19rpx; color: var(--ink-soft); line-height: 1; }
