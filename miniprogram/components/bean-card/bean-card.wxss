.card.bc { background: var(--card); border-radius: 36rpx; overflow: hidden; position: relative; box-shadow: 0 4rpx 20rpx rgba(80,60,30,.08); border: 2rpx solid rgba(80,60,30,.06); }
.ph-wrap { position: relative; width: 100%; height: 300rpx; }
.ph { width: 100%; height: 100%; }
.ph-fb { display: flex; align-items: center; justify-content: center; font-size: 80rpx; font-family: var(--font-display); color: #8A8172; background: linear-gradient(160deg,#F1E7D2,#E5D6BB); }
.roast { position: absolute; top: 16rpx; left: 16rpx; height: 44rpx; min-width: 44rpx; padding: 0 12rpx; border-radius: 22rpx; display: flex; align-items: center; justify-content: center; font-size: 18rpx; font-weight: 700; color: #fff; }
.roast.r1 { background: #D9B779; }
.roast.r2 { background: #A9713C; }
.roast.r3 { background: #5C3A21; }
.pill { position: absolute; top: 16rpx; right: 16rpx; padding: 6rpx 16rpx; border-radius: 999rpx; font-size: 20rpx; font-weight: 700; color: #fff; box-shadow: 0 2rpx 8rpx rgba(0,0,0,.15); }
.hurry { position: absolute; bottom: 16rpx; left: 16rpx; padding: 6rpx 16rpx; border-radius: 999rpx; background: rgba(249,115,22,.92); color: #fff; font-size: 20rpx; font-weight: 700; box-shadow: 0 2rpx 8rpx rgba(0,0,0,.18); }
.new { position: absolute; bottom: 16rpx; right: 16rpx; background: var(--accent); color: #fff; font-size: 18rpx; padding: 4rpx 12rpx; border-radius: 16rpx; font-weight: 600; }
.info { padding: 16rpx 20rpx 20rpx; }
.brand { font-size: 20rpx; color: #8A8172; margin-bottom: 4rpx; text-transform: uppercase; letter-spacing: 2rpx; }
.name { font-family: var(--font-display); font-size: 28rpx; font-weight: 600; color: var(--ink); line-height: 1.3; margin-bottom: 12rpx; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.meta { display: flex; align-items: center; justify-content: space-between; }
.flavors { display: flex; flex-wrap: wrap; gap: 8rpx; }
.fi { width: 40rpx; height: 40rpx; border-radius: 50%; background: #fff; border: 2rpx solid rgba(80,60,30,.12); display: flex; align-items: center; justify-content: center; font-size: 22rpx; }
.fi-img { width: 40rpx; height: 40rpx; border-radius: 50%; background: #fff; border: 2rpx solid rgba(80,60,30,.12); }
.avg { font-size: 20rpx; color: #F5A623; font-weight: 600; }
