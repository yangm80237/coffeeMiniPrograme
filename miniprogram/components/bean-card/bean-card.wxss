.card.bc { background: var(--card); border-radius: 36rpx; overflow: hidden; position: relative; box-shadow: 0 4rpx 20rpx rgba(80,60,30,.08); border: 2rpx solid rgba(80,60,30,.06); }
.ph-wrap { position: relative; width: 100%; height: 192rpx; }
.ph { width: 100%; height: 100%; }
.ph-fb { display: flex; align-items: center; justify-content: center; font-size: 56rpx; font-family: var(--font-display); color: #8A8172; background: linear-gradient(160deg,#F1E7D2,#E5D6BB); }
.roast { position: absolute; top: 14rpx; left: 14rpx; height: 40rpx; min-width: 40rpx; padding: 0 12rpx; border-radius: 20rpx; display: flex; align-items: center; justify-content: center; font-size: 18rpx; font-weight: 700; color: #fff; }
.roast.r1 { background: #D9B779; }
.roast.r2 { background: #A9713C; }
.roast.r3 { background: #5C3A21; }
.pill { position: absolute; top: 14rpx; right: 14rpx; padding: 4rpx 14rpx; border-radius: 999rpx; font-size: 19rpx; font-weight: 700; color: #fff; box-shadow: 0 2rpx 8rpx rgba(0,0,0,.15); }
.hurry { position: absolute; bottom: 14rpx; left: 14rpx; padding: 4rpx 14rpx; border-radius: 999rpx; background: rgba(249,115,22,.92); color: #fff; font-size: 19rpx; font-weight: 700; box-shadow: 0 2rpx 8rpx rgba(0,0,0,.18); }
/* 养豆进度条 */
.rest-bar { display: flex; align-items: center; gap: 12rpx; padding: 0 20rpx 12rpx; }
.rest-progress { flex: 1; height: 8rpx; border-radius: 4rpx; background: rgba(80,60,30,.1); overflow: hidden; }
.rest-fill { height: 100%; background: linear-gradient(90deg,#C9D8BC,#A9BF9E); border-radius: 4rpx; transition: width .3s; }
.rest-text { font-size: 19rpx; color: var(--ink-2); white-space: nowrap; }
.info { padding: 16rpx 20rpx 20rpx; }
.brand-row { display: flex; align-items: center; gap: 10rpx; margin-bottom: 4rpx; }
.brand { font-size: 20rpx; color: #8A8172; text-transform: uppercase; letter-spacing: 2rpx; }
.new { background: var(--accent); color: #fff; font-size: 17rpx; padding: 2rpx 10rpx; border-radius: 10rpx; font-weight: 600; line-height: 1.4; }
.name { font-family: var(--font-display); font-size: 28rpx; font-weight: 600; color: var(--ink); line-height: 1.3; margin-bottom: 12rpx; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.meta { display: flex; align-items: center; justify-content: space-between; }
.flavors { display: flex; flex-wrap: wrap; gap: 8rpx; }
.fi { width: 54rpx; height: 54rpx; border-radius: 50%; background: #fff; border: 2rpx solid rgba(80,60,30,.12); display: flex; align-items: center; justify-content: center; font-size: 28rpx; }
.fi-img { width: 54rpx; height: 54rpx; border-radius: 50%; background: #fff; border: 2rpx solid rgba(80,60,30,.12); }
.avg { font-size: 20rpx; color: #F5A623; font-weight: 600; }
