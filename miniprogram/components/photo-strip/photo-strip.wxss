.strip { display: flex; gap: 16rpx; }
.cell { width: 120rpx; height: 120rpx; border-radius: 16rpx; overflow: hidden; border: 4rpx solid transparent; flex-shrink: 0; position: relative; }
.cell.on { border-color: var(--accent); }
.cell.add { display: flex; align-items: center; justify-content: center; color: var(--ink-3); font-size: 40rpx; }
.img { width: 100%; height: 100%; }
.badge { position: absolute; top: 4rpx; right: 4rpx; z-index: 2; font-size: 16rpx; line-height: 1; background: var(--accent); color: #fff; border-radius: 999rpx; padding: 4rpx 12rpx; white-space: nowrap; }
/* 放大查看按钮：半透明圆角，不挡封面角标 */
.zoom-btn {
  position: absolute; right: 4rpx; bottom: 4rpx; z-index: 2;
  width: 36rpx; height: 36rpx; border-radius: 50%;
  background: rgba(0,0,0,.35); color: #fff;
  font-size: 20rpx; line-height: 36rpx; text-align: center;
}
