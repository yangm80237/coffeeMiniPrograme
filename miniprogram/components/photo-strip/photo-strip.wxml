<view class="strip">
  <view wx:for="{{photos}}" wx:key="*this" data-i="{{index}}" bindtap="select" bindlongpress="zoom"
    class="cell {{index === current ? 'on' : ''}}">
    <image src="{{item}}" mode="aspectFill" class="img" />
    <view wx:if="{{index === current && badgeLabel}}" class="badge">{{badgeLabel}}</view>
    <!-- 放大查看按钮：不冒泡，避免触发选封面 -->
    <view class="zoom-btn" catchtap="zoom" data-i="{{index}}">🔍</view>
  </view>
  <view class="cell add" bindtap="add">＋</view>
</view>
