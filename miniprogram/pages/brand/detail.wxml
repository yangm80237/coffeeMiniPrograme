<!-- 品牌详情（原型 screen-brand-detail 1369–1400 搬运） -->
<view class="brand-detail">
  <view class="bd-hero">
    <image wx:if="{{brand.logo}}" class="bd-logo img" src="{{brand.logo}}" mode="aspectFill" />
    <view wx:else class="bd-logo">{{first}}</view>
    <view class="bd-name">{{brand.name}}</view>
    <view class="bd-desc">{{brand.flag}} {{brand.country}}<text wx:if="{{brand.description}}"> · {{brand.description}}</text></view>
    <view class="bd-edit" bindtap="goEdit">✏️ 编辑品牌</view>
    <view class="bd-stats">
      <view><text class="b">{{beans.length}}</text><text class="small">在库袋数</text></view>
      <view><text class="b">{{avgScore || '—'}}</text><text class="small">平均评分</text></view>
    </view>
  </view>

  <view class="attr-section-title">该品牌豆子</view>
  <view class="bean-wrap" wx:if="{{beans.length}}">
    <bean-card wx:for="{{beans}}" wx:key="_id" bean="{{item}}"
      data-id="{{item._id}}" bindtap="openBean" />
  </view>
  <view class="empty" wx:else>
    <view class="empty-icon">🫘</view>
    <view class="empty-text">该品牌还没有在库豆子</view>
  </view>
</view>
