/* 品牌库列表——样式从 docs/prototype.html screen-brand 段搬运 ×2 换算 rpx */

.brand-page { position: relative; min-height: 100vh; }

/* 搜索 + 图标按钮 */
.header-row {
  padding: 8rpx 32rpx 24rpx; display: flex; align-items: center; gap: 16rpx;
  position: relative;
}
.search-input {
  flex: 1; padding: 20rpx 24rpx;
  border: 2rpx solid rgba(80, 60, 30, .14); border-radius: 24rpx;
  font-size: 26rpx; background: var(--card); color: var(--ink);
  box-sizing: border-box;
}
.icon-btn {
  width: 64rpx; height: 64rpx; flex: 0 0 auto; border-radius: 50%; background: #fff;
  display: flex; align-items: center; justify-content: center;
  font-size: 30rpx; box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, .06); box-sizing: border-box;
}

/* 国家多选下拉 */
.mask { position: fixed; left: 0; top: 0; right: 0; bottom: 0; z-index: 40; }
.filter-pop {
  position: absolute; top: 108rpx; right: 32rpx; width: 380rpx;
  background: var(--card); border-radius: 28rpx;
  box-shadow: 0 20rpx 68rpx rgba(40, 30, 10, .18);
  padding: 24rpx; z-index: 41;
}
.filter-title { font-size: 22rpx; color: var(--ink-2); margin-bottom: 16rpx; }
.filter-item {
  display: flex; align-items: center; gap: 16rpx;
  font-size: 26rpx; padding: 12rpx 4rpx; color: var(--ink);
}
.cbx {
  width: 32rpx; height: 32rpx; border-radius: 8rpx;
  border: 2rpx solid rgba(80, 60, 30, .28);
  display: flex; align-items: center; justify-content: center;
  font-size: 20rpx; color: #fff; box-sizing: border-box;
}
.cbx.on { background: var(--accent); border-color: var(--accent); }
.filter-actions { margin-top: 16rpx; text-align: right; font-size: 22rpx; color: var(--accent); }

/* 品牌列表 */
.brand-list { padding: 0 32rpx 40rpx; }
.brand-item {
  display: flex; align-items: center; gap: 24rpx; padding: 24rpx;
  background: #fff; border-radius: 24rpx; margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(80, 60, 30, .04);
}
.brand-item-logo {
  width: 80rpx; height: 80rpx; flex: 0 0 auto; border-radius: 20rpx;
  display: flex; align-items: center; justify-content: center;
  color: #fff; font-size: 28rpx; font-weight: 700;
}
.brand-item-logo.img { width: 80rpx; height: 80rpx; }
.brand-item-info { flex: 1; min-width: 0; }
.brand-item-name { font-size: 28rpx; font-weight: 600; }
.brand-item-desc {
  font-size: 22rpx; color: var(--ink-3); margin-top: 4rpx;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.brand-item-count { font-size: 22rpx; color: var(--green); font-weight: 600; flex: 0 0 auto; }

/* 空态 */
.empty { display: flex; flex-direction: column; align-items: center; padding: 100rpx 40rpx; }
.empty-icon { font-size: 96rpx; margin-bottom: 24rpx; opacity: .5; }
.empty-text { font-size: 28rpx; color: var(--ink-3); }

/* 底部新增 */
.bottom { padding: 28rpx 32rpx 60rpx; }
.tip { font-size: 22rpx; color: var(--ink-3); text-align: center; margin-top: 20rpx; }
.btn-ink { background: var(--ink); color: #fff; }
