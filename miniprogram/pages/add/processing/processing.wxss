/* AI 识别中页——深色沉浸，样式从 docs/prototype.html screen-processing (858–893) 搬运 ×2 换算 rpx */
page { background: #1C1712; color: #fff; }
.processing { min-height: 100vh; }
/* 顶栏 */
.proc-header {
  display: flex; align-items: center; gap: 24rpx;
  padding: 0 32rpx 24rpx;
}
.proc-title {
  flex: 1; font-size: 34rpx; font-weight: 700; color: #fff;
  font-family: var(--font-display); letter-spacing: 1rpx; text-align: center;
}
.back-btn { font-size: 40rpx; width: 64rpx; color: #fff; flex-shrink: 0; }
.nav-spacer { width: 180rpx; flex-shrink: 0; }
/* 步骤条 */
.proc-steps {
  display: flex; align-items: center; justify-content: center; gap: 16rpx;
  padding: 20rpx 32rpx 28rpx; font-size: 21rpx; color: rgba(255,255,255,.5);
}
.proc-steps .arr { color: rgba(255,255,255,.26); }
.proc-steps .cur { color: #E89B6F; font-weight: 600; }
/* 冲煮动画 */
brew-animation { display: block; }
/* 阶段提示 */
.proc-hint {
  text-align: center; font-size: 24rpx; color: rgba(255,255,255,.68);
  margin-top: 20rpx; min-height: 32rpx;
}
/* 识别较慢的说明 */
.proc-note {
  text-align: center; font-size: 20rpx; color: rgba(255,255,255,.42);
  margin-top: 8rpx; padding: 0 48rpx;
}
/* 闪点 */
.proc-dots { display: flex; gap: 10rpx; justify-content: center; margin-top: 16rpx; }
.proc-dots .dot {
  width: 10rpx; height: 10rpx; border-radius: 50%;
  background: rgba(255,255,255,.4); animation: dotBlink 1.4s infinite;
}
.proc-dots .dot:nth-child(2) { animation-delay: .2s; }
.proc-dots .dot:nth-child(3) { animation-delay: .4s; }
@keyframes dotBlink {
  0%,100% { opacity: .25; transform: translateY(0); }
  40% { opacity: 1; transform: translateY(-6rpx); }
}
/* 跳过 */
.proc-skip {
  display: block; margin: 40rpx 32rpx calc(env(safe-area-inset-bottom) + 68rpx);
  width: calc(100% - 64rpx); padding: 24rpx; border-radius: 999rpx; box-sizing: border-box;
  background: rgba(255,255,255,.1); color: rgba(255,255,255,.85);
  border: 2rpx solid rgba(255,255,255,.22); font-size: 24rpx; text-align: center;
}
/* 识别失败错误卡（原地吐错，深色主题红系） */
.proc-error {
  margin: 24rpx 40rpx; padding: 48rpx 40rpx;
  background: rgba(229,72,77,.12); border: 2rpx solid rgba(229,72,77,.4);
  border-radius: 28rpx; text-align: center;
}
.proc-error-icon { font-size: 72rpx; margin-bottom: 20rpx; }
.proc-error-title { font-size: 32rpx; font-weight: 700; color: #fff; margin-bottom: 16rpx; }
.proc-error-msg {
  font-size: 23rpx; color: rgba(255,255,255,.75); line-height: 1.6;
  word-break: break-all; font-family: monospace;
  background: rgba(0,0,0,.25); border-radius: 16rpx; padding: 20rpx;
  margin-bottom: 36rpx; text-align: left;
}
.proc-error-btn {
  display: block; width: 100%; box-sizing: border-box;
  padding: 24rpx; border-radius: 999rpx; font-size: 28rpx; font-weight: 600;
  margin-bottom: 20rpx; line-height: 1.2;
}
.proc-error-btn.primary {
  background: linear-gradient(135deg,#E89B6F,#C9602F); color: #1C1712;
  border: none;
}
.proc-error-btn.ghost {
  background: transparent; color: rgba(255,255,255,.85);
  border: 2rpx solid rgba(255,255,255,.3);
}
.proc-error-btn[disabled] { opacity: .6; }
