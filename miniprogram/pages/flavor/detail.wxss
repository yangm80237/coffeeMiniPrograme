/* 风味标签详情——样式从 docs/prototype.html screen-flavor-detail 段搬运 ×2 换算 rpx */

/* 头部 */
.fd-hero { text-align: center; padding: 16rpx 32rpx 32rpx; }
.fd-icon {
  width: 192rpx; height: 192rpx; margin: 0 auto 20rpx; border-radius: 50%;
  background: var(--card); box-shadow: 0 2rpx 12rpx rgba(80, 60, 30, .06);
  display: flex; align-items: center; justify-content: center;
  font-size: 88rpx; overflow: hidden;
}
.fd-img { width: 100%; height: 100%; }
.fd-name { font-family: var(--font-display); font-size: 40rpx; font-weight: 700; color: var(--ink); }
.fd-cat { font-size: 24rpx; color: var(--ink-2); margin-top: 8rpx; }

/* 表单 */
.form-section { padding: 0 32rpx 32rpx; }
.form-label { font-size: 24rpx; color: var(--ink-2); margin-bottom: 12rpx; font-weight: 500; }
.form-input {
  width: 100%; height: 72rpx; line-height: 72rpx; padding: 0 24rpx; box-sizing: border-box;
  border: 2rpx solid rgba(80, 60, 30, .14); border-radius: 16rpx;
  font-size: 26rpx; background: var(--card); color: var(--ink); margin-bottom: 24rpx;
}
.form-input.picker { display: flex; align-items: center; justify-content: space-between; }
.form-input .caret { color: var(--ink-3); font-size: 22rpx; }
.ai-tag { font-size: 18rpx; background: var(--accent); color: #fff; padding: 4rpx 12rpx; border-radius: 12rpx; }

/* 图标对比（重新生成后出现） */
.icon-compare {
  display: flex; align-items: center; justify-content: center; gap: 32rpx;
  margin: 24rpx 0;
}
.compare-box { display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.compare-thumb {
  width: 120rpx; height: 120rpx; border-radius: 50%; background: var(--card);
  display: flex; align-items: center; justify-content: center; font-size: 56rpx;
  border: 2rpx solid rgba(80,60,30,.1); overflow: hidden;
}
.compare-thumb img { width: 100%; height: 100%; }
.compare-label { font-size: 20rpx; color: var(--ink-3); }
.compare-vs { font-size: 28rpx; color: var(--ink-3); }

/* 按钮行 */
.btn-row { display: flex; gap: 16rpx; margin-top: 8rpx; }
.btn-row.gap { margin-top: 16rpx; }
.flex1 { flex: 1; }
.btn-ink { background: var(--ink); color: #fff; }
.pill {
  height: var(--btn-h); line-height: 72rpx; border-radius: 999rpx;
  font-size: 26rpx; text-align: center; padding: 0 24rpx; box-sizing: border-box;
}
.pill.dark { background: var(--ink); color: #fff; }
.pill.light { background: var(--card); color: var(--ink); border: 2rpx solid rgba(80, 60, 30, .14); }
.pill.del { flex: 0 0 168rpx; }
