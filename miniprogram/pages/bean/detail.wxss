/* 豆子详情页——样式从 docs/prototype.html screen-detail (1011–1102) 搬运 ×2 换算 rpx */
.detail { min-height: 100vh; }
/* 顶栏 ⋯ */
.page-nav { display: flex; align-items: center; padding: 16rpx 32rpx; }
.nav-spacer { flex: 1; }
.more-btn {
  width: 64rpx; height: 64rpx; display: flex; align-items: center; justify-content: center;
  font-size: 32rpx; font-weight: 700; color: var(--ink);
}
/* ⋯ 浮层菜单 */
.menu-mask {
  position: fixed; left: 0; top: 0; right: 0; bottom: 0; z-index: 40; background: rgba(26,27,28,.3);
}
.menu-pop {
  position: fixed; top: 120rpx; right: 24rpx; z-index: 41; width: 352rpx;
  background: #FFFDF8; border-radius: 28rpx; box-shadow: 0 16rpx 56rpx rgba(0,0,0,.18);
  padding: 16rpx; border: 2rpx solid rgba(80,60,30,.08);
}
.menu-pop::before {
  content: ''; width: 24rpx; height: 24rpx; background: #FFFDF8; position: absolute;
  top: -12rpx; right: 32rpx; transform: rotate(45deg);
  border-top: 2rpx solid rgba(80,60,30,.08); border-left: 2rpx solid rgba(80,60,30,.08);
}
.menu-item { padding: 22rpx 24rpx; border-radius: 20rpx; font-size: 26rpx; color: var(--ink); }
.menu-item:active { background: rgba(80,60,30,.06); }
.menu-item.disabled { color: #9CA3AF; }
.menu-item.danger { color: #DC2626; }
/* 主视觉 */
.detail-hero { padding: 0 32rpx 24rpx; text-align: center; }
.photo-swiper { width: 280rpx; height: 360rpx; margin: 0 auto 24rpx; border-radius: 24rpx; overflow: hidden; }
.photo-single {
  width: 280rpx; height: 360rpx; margin: 0 auto 24rpx; border-radius: 24rpx; display: block;
}
.photo-placeholder {
  width: 280rpx; height: 360rpx; margin: 0 auto 24rpx; border-radius: 24rpx;
  background: linear-gradient(135deg,#2d2d2d,#4a4a4a);
  display: flex; align-items: center; justify-content: center; font-size: 100rpx;
}
.detail-name {
  font-family: var(--font-display); font-size: 36rpx; font-weight: 700; color: #1A1B1C;
  line-height: 1.3; margin-bottom: 8rpx;
}
.detail-brand { font-size: 26rpx; color: var(--ink-2); display: flex; align-items: center; justify-content: center; gap: 12rpx; }
.detail-brand .brand-arrow { font-size: 32rpx; color: #999; }
.flavor-hero { display: flex; align-items: center; justify-content: center; gap: 12rpx; margin: 24rpx 0 16rpx; }
.fh-emoji { font-size: 96rpx; line-height: 1.15; filter: drop-shadow(0 6rpx 12rpx rgba(60,40,20,.16)); }
.fh-img { width: 96rpx; height: 96rpx; }
.flavor-names {
  font-family: var(--font-display); font-style: italic; font-size: 26rpx; color: var(--ink-3);
  text-align: center; margin-top: 8rpx; letter-spacing: 1rpx;
}
/* 状态条：底色随四态（×2 取自原型注释色值） */
.status-bar {
  margin: 0 32rpx 32rpx; padding: 20rpx 28rpx; border-radius: 20rpx;
  display: flex; align-items: center; justify-content: space-between;
}
.status-bar.s-resting { background: #FFF8E6; }
.status-bar.s-drinking { background: #EAF7EA; }
.status-bar.s-hurry { background: #FFF4EC; }
.status-bar.s-finished { background: #F0F0F0; }
.status-left { display: flex; align-items: center; gap: 16rpx; }
.status-right { font-size: 22rpx; color: var(--ink-2); }
/* 评分并排区 */
.rating-section { display: flex; gap: 20rpx; padding: 0 32rpx 32rpx; }
.rating-card {
  flex: 1; background: #fff; border-radius: 24rpx; padding: 24rpx; text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,.04);
}
.rating-label { font-size: 22rpx; color: var(--ink-3); margin-bottom: 8rpx; }
.rating-score { font-size: 40rpx; font-weight: 700; color: #1A1B1C; margin-top: 4rpx; }
/* 属性标题 */
.attr-section-title {
  font-size: 24rpx; color: var(--ink-2); text-align: center; padding: 16rpx 32rpx;
  display: flex; align-items: center; gap: 20rpx;
}
.attr-section-title::before, .attr-section-title::after {
  content: ''; flex: 1; height: 2rpx; background: rgba(80,60,30,.14);
}
.attr-wrap { padding: 6rpx 32rpx 44rpx; }
/* 底部操作栏 */
.detail-actions { display: flex; gap: 24rpx; padding: 24rpx 32rpx calc(env(safe-area-inset-bottom) + 48rpx); }
.detail-actions .btn { flex: 1; }
/* 评分弹层 */
.sheet-mask {
  position: fixed; left: 0; top: 0; right: 0; bottom: 0; z-index: 50; background: rgba(26,27,28,.35);
}
.add-sheet {
  position: fixed; bottom: 0; left: 0; right: 0; z-index: 60; background: #fff;
  border-radius: 40rpx 40rpx 0 0; padding: 40rpx 40rpx calc(env(safe-area-inset-bottom) + 60rpx);
  box-shadow: 0 -8rpx 40rpx rgba(0,0,0,.1);
}
.sheet-handle { width: 72rpx; height: 8rpx; background: #ddd; border-radius: 4rpx; margin: 0 auto 32rpx; }
.sheet-title { font-size: 32rpx; font-weight: 700; text-align: center; margin-bottom: 24rpx; }
.rate-row { display: flex; align-items: center; gap: 24rpx; padding: 20rpx 8rpx; }
.rate-who { font-size: 26rpx; font-weight: 600; width: 72rpx; color: var(--ink); }
.rate-stars { flex: 1; }
.rate-num { font-size: 32rpx; font-family: var(--font-display); }
.rate-tip { font-size: 21rpx; color: var(--ink-3); margin: 4rpx 0 8rpx; }
.form-label { font-size: 24rpx; color: var(--ink-2); margin-bottom: 12rpx; font-weight: 500; }
.form-textarea {
  box-sizing: border-box; width: 100%; min-height: 160rpx; padding: 16rpx 24rpx;
  border: 2rpx solid rgba(80,60,30,.14); border-radius: 20rpx;
  font-size: 26rpx; background: var(--card); color: var(--ink); margin-bottom: 24rpx;
}
.save-rating { margin-top: 8rpx; }
