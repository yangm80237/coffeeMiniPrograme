/* 统计页——样式从 docs/prototype.html screen-stats 段搬运 ×2 换算 rpx */

/* 深色汇总头 */
.stats-head {
  background: var(--ink); color: #fff;
  margin: 24rpx 32rpx; border-radius: 24rpx; padding: 32rpx;
}
.stats-title { font-family: var(--font-display); font-size: 40rpx; letter-spacing: 1rpx; }
.stats-title .yr { font-size: 24rpx; opacity: .6; margin-left: 12rpx; font-family: -apple-system, 'PingFang SC', sans-serif; }
.stats-sum { display: flex; justify-content: space-between; margin-top: 28rpx; text-align: center; }
.sum-item { display: flex; flex-direction: column; }
.stats-sum .b, .stats-foot .b { font-size: 40rpx; font-family: var(--font-display); }
.stats-sum .small, .stats-foot .small { font-size: 20rpx; opacity: .65; }

/* 卡片段 */
.stats-card {
  background: var(--card); border-radius: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(80, 60, 30, .06);
  margin: 0 32rpx 24rpx; padding: 28rpx;
}
.card-h { font-size: 24rpx; color: var(--ink-2); font-weight: 600; margin-bottom: 20rpx; }
.card-empty { font-size: 24rpx; color: var(--ink-3); text-align: center; padding: 16rpx 0; }

/* 状态占比条（drinking 段内嵌绿色在喝 + 橙色 hurry 子段） */
.dist { display: flex; height: 20rpx; border-radius: 10rpx; overflow: hidden; gap: 4rpx; background: rgba(80, 60, 30, .08); }
.seg { display: flex; overflow: hidden; }
.part { height: 100%; }
.dist-legend { display: flex; justify-content: space-between; font-size: 20rpx; color: var(--ink-2); margin-top: 12rpx; }

/* 处理法 */
.proc-row { font-size: 26rpx; color: var(--ink); font-family: var(--font-display); letter-spacing: 1rpx; }

/* 国家 / 豆种横条图 */
.country-row { display: flex; align-items: center; gap: 16rpx; margin-bottom: 16rpx; }
.country-row:last-child { margin-bottom: 0; }
.cname { width: 220rpx; font-size: 22rpx; color: var(--ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.cbar { flex: 1; height: 16rpx; border-radius: 8rpx; background: rgba(80, 60, 30, .08); overflow: hidden; }
.cbar-i { display: block; height: 100%; border-radius: 8rpx; background: linear-gradient(90deg, #C96F4A, #E09B6F); }
.cnum { font-size: 22rpx; color: var(--ink-2); width: 44rpx; text-align: right; font-family: var(--font-display); }

/* 点阵地图（canvas 2d） */
.dot-map { width: 100%; height: 300rpx; border-radius: 16rpx; }
.map-note { font-size: 20rpx; color: var(--ink-2); margin-top: 16rpx; }

/* 底部四指标 */
.stats-foot {
  display: flex; justify-content: space-around;
  background: var(--card); border-radius: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(80, 60, 30, .06);
  margin: 0 32rpx 60rpx; padding: 28rpx 0; text-align: center;
}
.foot-item { display: flex; flex-direction: column; }
.stats-foot .small { color: var(--ink-2); opacity: 1; }
