<!-- 管理页（新增页无原型，沿用 tokens 与卡片+btn 模式；规格书 3.9） -->
<view class="admin">
  <view class="card panel">
    <view class="panel-title">AI 模型配置 <text class="source-tag">{{sourceLabel}}</text></view>

    <view class="form-label">视觉识别模型 ID</view>
    <input class="form-input" placeholder="如：ep-vision-xxx" value="{{modelVision}}" bindinput="onVision" />

    <view class="form-label">生图模型 ID</view>
    <input class="form-input" placeholder="如：ep-image-xxx" value="{{modelImage}}" bindinput="onImage" />

    <view class="btn-row">
      <view class="btn btn-ink flex1" bindtap="save">保存</view>
      <view class="btn btn-gray test" bindtap="testConn">测试连接</view>
    </view>
    <view class="note">仅家庭创建者可修改；修改后影响 AI 识别与风味图标生成</view>

    <!-- ⚙️ 新风味自动生图开关（config.autoIcon，缺省开） -->
    <view class="switch-row">
      <view class="switch-info">
        <view class="switch-title">⚙️ 新风味自动生图</view>
        <view class="switch-desc">AI 识别出库外风味并在确认页勾选入库后，自动生成图标</view>
      </view>
      <switch checked="{{autoIcon}}" bindchange="onAutoIcon" color="#c96f4a" />
    </view>
  </view>

  <!-- 品牌库重初始化：全清重建 + AI 补资料，logo 留空手传；45s 预算断点续跑 -->
  <view class="card panel reinit">
    <view class="panel-title">品牌库重初始化</view>
    <view class="form-label">每行一条：「品牌名,国家」（中英文逗号均可）</view>
    <textarea class="reinit-input" value="{{reinitLines}}" bindinput="onReinitLines"
      placeholder="Blue Bottle,美国&#10;Fuglen,挪威" maxlength="-1" />
    <view class="btn-row">
      <view class="btn btn-danger flex1 {{reinitRunning ? 'is-busy' : ''}}" bindtap="startReinit">开始重建</view>
      <view wx:if="{{reinitRemaining > 0}}" class="btn btn-gray flex1 {{reinitRunning ? 'is-busy' : ''}}" bindtap="continueReinit">继续（剩 {{reinitRemaining}}）</view>
    </view>
    <view wx:if="{{reinitProcessed || reinitRemaining}}" class="note">
      本轮已处理 {{reinitProcessed}} · 剩余 {{reinitRemaining}}{{reinitNext ? ' · 下一个：' + reinitNext : ''}}
    </view>
    <view class="note danger">⚠️ 重建将清空现有全部品牌（含自建），老豆子的品牌关联会变空；logo 请重建后手动上传</view>
  </view>
</view>
