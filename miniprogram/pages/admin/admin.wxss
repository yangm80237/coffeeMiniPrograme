/* 管理页（新增页无原型，沿用 tokens 与卡片+btn 模式） */

.admin { min-height: 100vh; padding: 24rpx 32rpx 60rpx; box-sizing: border-box; }
.panel { padding: 32rpx; }

.panel-title {
  font-size: 30rpx; font-weight: 700; color: var(--ink); margin-bottom: 28rpx;
  display: flex; align-items: center; gap: 16rpx;
}
.source-tag {
  font-size: 20rpx; font-weight: 400; color: var(--accent);
  background: rgba(201, 111, 74, .12); border-radius: 999rpx; padding: 4rpx 16rpx;
}

.form-label { font-size: 24rpx; color: var(--ink-2); margin-bottom: 12rpx; font-weight: 500; }
.form-input {
  width: 100%; height: 72rpx; line-height: 72rpx; padding: 0 24rpx; box-sizing: border-box;
  border: 2rpx solid rgba(80, 60, 30, .14); border-radius: 16rpx;
  font-size: 26rpx; background: #fff; color: var(--ink); margin-bottom: 24rpx;
}

.btn-row { display: flex; gap: 16rpx; margin-top: 8rpx; }
.flex1 { flex: 1; }
.test { flex: 0 0 200rpx; }
.btn-ink { background: var(--ink); color: #fff; }
.note { font-size: 22rpx; color: var(--ink-3); margin-top: 24rpx; line-height: 1.6; }

/* ⚙️ 新风味自动生图开关行（沿用卡片内 note 上方分隔） */
.switch-row {
  display: flex; align-items: center; gap: 20rpx;
  border-top: 2rpx solid rgba(80, 60, 30, .08);
  margin-top: 28rpx; padding-top: 28rpx;
}
.switch-info { flex: 1; }
.switch-title { font-size: 26rpx; font-weight: 600; color: var(--ink); }
.switch-desc { font-size: 22rpx; color: var(--ink-3); margin-top: 6rpx; line-height: 1.5; }

/* 品牌库重初始化卡片（页面底部，沿用卡片+btn 模式） */
.reinit { margin-top: 24rpx; }
.reinit-input {
  width: 100%; height: 240rpx; padding: 20rpx 24rpx; box-sizing: border-box;
  border: 2rpx solid rgba(80, 60, 30, .14); border-radius: 16rpx;
  font-size: 24rpx; background: #fff; color: var(--ink); margin-bottom: 24rpx;
}
.btn-danger { background: #e64340; color: #fff; }
.is-busy { opacity: .6; pointer-events: none; }
.note.danger { color: #e64340; }
