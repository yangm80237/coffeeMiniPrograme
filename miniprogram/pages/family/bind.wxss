/* 家庭绑定页（新增页无原型，沿用 tokens 与卡片+btn 模式） */

.bind { min-height: 100vh; padding: 0 48rpx; box-sizing: border-box; }

.loading { padding: 320rpx 0; text-align: center; color: var(--ink-2); font-size: 28rpx; }

/* 头部 */
.hero { text-align: center; padding: 140rpx 0 60rpx; }
.hero-icon { font-size: 120rpx; margin-bottom: 24rpx; }
.hero-title { font-family: var(--font-display); font-size: 44rpx; font-weight: 700; color: var(--ink); }
.hero-desc { font-size: 26rpx; color: var(--ink-2); margin-top: 16rpx; }

/* 面板 */
.panel { padding: 40rpx 32rpx 48rpx; }
.divider { position: relative; text-align: center; margin: 36rpx 0; }
.divider text { font-size: 22rpx; color: var(--ink-3); background: var(--bg-paper); padding: 0 24rpx; position: relative; z-index: 1; }
.divider::before { content: ""; position: absolute; left: 0; right: 0; top: 50%; height: 2rpx; background: rgba(80, 60, 30, .1); }

.code-input {
  width: 100%; padding: 24rpx; box-sizing: border-box; text-align: center;
  border: 2rpx solid rgba(80, 60, 30, .14); border-radius: var(--btn-radius);
  font-size: 36rpx; letter-spacing: 12rpx; background: #fff; color: var(--ink);
  font-family: var(--font-display); font-weight: 700;
}
.join { margin-top: 24rpx; background: var(--ink); color: #fff; }
.btn-ink { background: var(--ink); color: #fff; }
